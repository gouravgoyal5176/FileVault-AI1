# Environment Configuration Template for FileVault
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDER VALUES FOR YOUR LOCAL SETUP

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:6100

# Database (PostgreSQL)
POSTGRES_USER=filevault_user
POSTGRES_PASSWORD=filevault_secure_password
POSTGRES_DB=filevault
DATABASE_URL=postgresql://filevault_user:filevault_secure_password@localhost:5432/filevault?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=filevault-vault

# Security & Cryptography Secrets
# MASTER_ENCRYPTION_KEY must be a 64-character hex string (32 bytes)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_placeholder
